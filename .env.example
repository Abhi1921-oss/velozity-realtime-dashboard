# Velozity Full-Stack Environment Configuration

# PostgreSQL Configuration (used by Docker Compose)
POSTGRES_USER=velozity_user
POSTGRES_PASSWORD=velozity_secure_password
POSTGRES_DB=velozity_dashboard
POSTGRES_PORT=5432

# Backend Environment
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://velozity_user:velozity_secure_password@localhost:5432/velozity_dashboard?schema=public"

JWT_ACCESS_SECRET="velozity_jwt_access_token_secret_key_prod_v1"
JWT_REFRESH_SECRET="velozity_jwt_refresh_token_secret_key_prod_v1"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client Configuration
CLIENT_URL="http://localhost:5173"
VITE_API_URL="http://localhost:5000"
VITE_WS_URL="http://localhost:5000"
